APP_NAME="ACOP Homologation"
APP_ENV=homologation
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1

# Somente MariaDB 10.1 descartável e isolado. Nunca reutilize credenciais reais.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33101
DB_DATABASE=acop_hml_mariadb101
DB_USERNAME=acop_hml
DB_PASSWORD=synthetic-only-change-me
DB_PREFIX=avt_
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=true

# Frase deliberadamente longa exigida pelo hard guard antes de qualquer DROP/migrate:fresh.
HOMOLOGATION_ALLOW_DESTRUCTIVE=I_UNDERSTAND_THIS_DATABASE_WILL_BE_DESTROYED

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
RECONCILIATION_V2_ENABLED=false
RECONCILIATION_MATCHING_ENABLED=false
