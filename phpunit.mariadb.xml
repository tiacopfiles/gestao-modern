<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache/mariadb">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
        <testsuite name="MariaDBHomologation"><directory>tests/Homologation</directory></testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <!--
            APP_ENV precisa ser `testing`, não `homologation`: o Laravel só
            desliga a validação de CSRF e outros atalhos de teste quando
            `runningUnitTests()` é verdadeiro, o que exige exatamente `testing`.
            Com `homologation` toda rota POST responde 419 e a suíte mede o
            harness em vez do produto.

            A proteção do banco NÃO depende deste valor: `Tests\TestCase::setUp()`
            executa `HomologationGuard::assertSafe()` em todo teste sob driver
            mysql/mariadb, exigindo loopback, database `acop_hml_*`/`acop_test_*`,
            MariaDB 10.1.x e a confirmação destrutiva explícita.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_PREFIX" value="avt_" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!--
            Flags forçadas OFF para que o estado do shell não vaze para dentro
            da suíte. Cada teste habilita o que precisa via `config([...])`.
        -->
        <env name="RECONCILIATION_V2_ENABLED" value="false" force="true"/>
        <env name="RECONCILIATION_MATCHING_ENABLED" value="false" force="true"/>
        <env name="RECONCILIATION_CLOSING_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
